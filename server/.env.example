# FlashAI Server Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
HOST=127.0.0.1

# ========================================================
# Real Gmail SMTP Notification System
# ========================================================
# FlashAI dispatches real emails directly to students' Gmail:
# - Daily reminders if the user hasn't studied today
# - Retention alerts if the user hasn't studied for 4+ days
#
# SETUP INSTRUCTIONS FOR GMAIL:
# 1. Go to Google Account Settings: https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is turned ON.
# 3. Search for "App passwords" (or go to https://myaccount.google.com/apppasswords).
# 4. Create an App password named "FlashAI".
# 5. Copy the 16-character code (e.g., abcd efgh ijkl mnop) and paste below without spaces.
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
FROM_EMAIL=your_email@gmail.com
APP_URL=http://localhost:5173
